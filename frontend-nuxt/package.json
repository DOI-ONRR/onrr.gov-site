{
  "name": "frontend-nuxt",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "copy:fonts": "rm -rf public/fonts && cp -r node_modules/@uswds/uswds/dist/fonts public/fonts",
    "postinstall": "nuxt prepare && npm run copy:fonts",
    "updateuswds": "npx gulp updateUswds",
    "heroku-postbuild": "npm run build",
    "test:e2e": "npx bddgen && npx playwright test",
    "test:e2e:ui": "npx bddgen && npx playwright test --ui"
  },
  "dependencies": {
    "@apollo/client": "^4.1.4",
    "@fontsource-variable/assistant": "^5.2.9",
    "@fontsource-variable/plus-jakarta-sans": "^5.2.8",
    "@headlessui/vue": "^1.7.23",
    "@nuxtjs/apollo": "^5.0.0-alpha.16",
    "@uswds/compile": "^1.3.1",
    "@uswds/uswds": "^3.13.0",
    "graphql": "^16.12.0",
    "highcharts": "^12.5.0",
    "nuxt": "^4.3.1",
    "sass": "^1.97.3",
    "vue": "^3.5.28"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "playwright-bdd": "^8.4.2"
  }
}
